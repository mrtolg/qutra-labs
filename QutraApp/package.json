{
  "name": "contextos",
  "private": true,
  "version": "0.1.0",
  "description": "Qutra Labs - local-first desktop operations workbench.",
  "type": "module",
  "license": "MIT",
  "author": "Mert Olgun",
  "overrides": {
    "brace-expansion": "5.0.9",
    "@eslint/config-array": {
      "minimatch": "10.2.6"
    },
    "@eslint/eslintrc": {
      "minimatch": "10.2.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "10.2.6"
    },
    "eslint": {
      "minimatch": "10.2.6"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "3.1.5"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run bundle:check",
    "preview": "vite preview",
    "typecheck": "tsc -b --force --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gate.ps1",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "tauri:build:smoke": "tauri build --config src-tauri/tauri.smoke.conf.json",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "brand:icons": "node scripts/build-q-icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.474.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
